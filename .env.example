# Copy this file to .env and fill in your values. .env is gitignored --
# never commit real endpoint/deployment values here.

# Azure AI Foundry account endpoint (the "AIServices" resource itself, not
# the project sub-path), e.g. https://your-foundry-resource.services.ai.azure.com
AZURE_AI_ENDPOINT=

# The GPT-5 model deployment name in that resource (the name you gave the
# deployment, not the base model name).
AZURE_AI_DEPLOYMENT=

# Azure OpenAI API version for the classic chat-completions surface.
AZURE_AI_API_VERSION=2024-10-21

# Optional: customize the shopping assistant's brand name in its persona.
# SHOPPING_AGENT_BRAND_NAME="a premium outerwear and apparel retailer"
